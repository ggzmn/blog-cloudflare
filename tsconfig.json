{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*":    ["./src/layouts/*"],
      "@styles/*":     ["./src/styles/*"],
      "@utils/*":      ["./src/utils/*"],
      "@content/*":    ["./src/content/*"],
      "@constants/*":  ["./src/constants/*"],
      "@assets/*":  ["./src/assets/*"],
    }
  }
}
